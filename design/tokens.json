{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "$description": "Boona design tokens. Single source of truth. Direction B · Readout, approved 2026-11-03. Light values are $value; dark values live in $extensions.boona.dark. Run `node design/scripts/build-tokens.mjs` after any change.",
  "$extensions": {
    "boona": {
      "version": "0.1.0",
      "modes": ["light", "dark"],
      "defaultMode": "light",
      "accessibility": "All text/background pairs checked against WCAG 2.2 AA (4.5:1 body, 3:1 at 24px+/700). Product accents are tuned per surface: `.accent` is bar-safe on black, `.ink` is text-safe on ground."
    }
  },

  "color": {
    "primitive": {
      "$description": "Raw values. Never used directly in UI; semantic tokens alias them.",
      "white": { "$type": "color", "$value": "#FFFFFF" },
      "black": { "$type": "color", "$value": "#000000" },
      "grey-100": { "$type": "color", "$value": "#F3F3F1" },
      "grey-200": { "$type": "color", "$value": "#DEDEDE" },
      "grey-400": { "$type": "color", "$value": "#B8B8B8" },
      "grey-600": { "$type": "color", "$value": "#5A5A5A" },
      "grey-700": { "$type": "color", "$value": "#3A3B40" },
      "grey-800": { "$type": "color", "$value": "#26272B" },
      "grey-900": { "$type": "color", "$value": "#1F2023" },
      "grey-050-dark": { "$type": "color", "$value": "#F2F2F0" },
      "grey-300-dark": { "$type": "color", "$value": "#A5A6AC" },
      "coral-300": { "$type": "color", "$value": "#E06A5F" },
      "coral-600": { "$type": "color", "$value": "#C8453A" },
      "coral-200": { "$type": "color", "$value": "#F28B82" },
      "plum-300": { "$type": "color", "$value": "#A98BDC" },
      "plum-600": { "$type": "color", "$value": "#6B3FA0" },
      "plum-200": { "$type": "color", "$value": "#C4A5F0" },
      "teal-300": { "$type": "color", "$value": "#3FC9B0" },
      "teal-600": { "$type": "color", "$value": "#0F766E" },
      "teal-200": { "$type": "color", "$value": "#5EEAD4" },
      "red-300": { "$type": "color", "$value": "#FF8A80" },
      "red-600": { "$type": "color", "$value": "#B3261E" },
      "red-200": { "$type": "color", "$value": "#FFB4AE" },
      "blue-600": { "$type": "color", "$value": "#1D4ED8" },
      "blue-300": { "$type": "color", "$value": "#8AB0FF" }
    },

    "ground": {
      "$type": "color", "$value": "{color.primitive.white}",
      "$description": "Page background.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-900}" } }
    },
    "surface": {
      "$type": "color", "$value": "{color.primitive.grey-100}",
      "$description": "Cards, code blocks, form fields. One step off the ground, no shadow.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-800}" } }
    },
    "ink": {
      "$type": "color", "$value": "{color.primitive.black}",
      "$description": "Primary text, primary button fill, rules. True black, not tinted.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-050-dark}" } }
    },
    "quiet": {
      "$type": "color", "$value": "{color.primitive.grey-600}",
      "$description": "Secondary text, captions, windows. 6.9:1 on ground.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-300-dark}" } }
    },
    "line": {
      "$type": "color", "$value": "{color.primitive.grey-200}",
      "$description": "Dividers, outlines, table rules. Non-text only.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-700}" } }
    },
    "on-ink": {
      "$type": "color", "$value": "{color.primitive.white}",
      "$description": "Text on ink fills (primary button).",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-900}" } }
    },

    "bar": {
      "$type": "color", "$value": "{color.primitive.black}",
      "$description": "The readout bar. Black in both modes: the bar is the one constant across every surface.",
      "$extensions": { "boona": { "dark": "{color.primitive.black}" } }
    },
    "on-bar": {
      "$type": "color", "$value": "{color.primitive.white}",
      "$description": "Label and number on the bar.",
      "$extensions": { "boona": { "dark": "{color.primitive.white}" } }
    },
    "quiet-on-bar": {
      "$type": "color", "$value": "{color.primitive.grey-400}",
      "$description": "The window text on the bar. 10.6:1 on black.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-400}" } }
    },
    "proof": {
      "$type": "color", "$value": "{color.primitive.white}",
      "$description": "The measured number on the bar. Alias of on-bar so the number is never a colour, only a weight.",
      "$extensions": { "boona": { "dark": "{color.primitive.white}" } }
    },
    "warning-outage": {
      "$type": "color", "$value": "{color.primitive.red-300}",
      "$description": "Scars, incidents, a bar with no telemetry. Accent square on the bar (9.2:1 on black).",
      "$extensions": { "boona": { "dark": "{color.primitive.red-300}" } }
    },
    "warning-outage-ink": {
      "$type": "color", "$value": "{color.primitive.red-600}",
      "$description": "Scar text on ground (6.5:1 on white).",
      "$extensions": { "boona": { "dark": "{color.primitive.red-200}" } }
    },

    "link": {
      "$type": "color", "$value": "{color.primitive.black}",
      "$description": "Links are ink with an underline, never a colour.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-050-dark}" } }
    },
    "focus": {
      "$type": "color", "$value": "{color.primitive.blue-600}",
      "$description": "Keyboard focus ring. The only blue in the system, so focus is unmistakable.",
      "$extensions": { "boona": { "dark": "{color.primitive.blue-300}" } }
    },
    "error": {
      "$type": "color", "$value": "{color.primitive.red-600}",
      "$description": "Form validation text and borders.",
      "$extensions": { "boona": { "dark": "{color.primitive.red-200}" } }
    },
    "success": {
      "$type": "color", "$value": "{color.primitive.teal-600}",
      "$description": "Form success text.",
      "$extensions": { "boona": { "dark": "{color.primitive.teal-200}" } }
    },
    "selection": {
      "$type": "color", "$value": "{color.primitive.grey-200}",
      "$description": "Text selection background.",
      "$extensions": { "boona": { "dark": "{color.primitive.grey-700}" } }
    }
  },

  "product": {
    "$description": "One accent slot per product or service. `.accent` sits on the bar (black); `.ink` is text on ground. Add a product by adding a group with both.",
    "azhagi": {
      "accent": { "$type": "color", "$value": "{color.primitive.coral-300}", "$description": "Azhagi square on the bar. 6.4:1 on black.", "$extensions": { "boona": { "dark": "{color.primitive.coral-300}" } } },
      "ink": { "$type": "color", "$value": "{color.primitive.coral-600}", "$description": "Azhagi text on ground. 4.8:1 on white.", "$extensions": { "boona": { "dark": "{color.primitive.coral-200}" } } }
    },
    "cue": {
      "accent": { "$type": "color", "$value": "{color.primitive.plum-300}", "$description": "Boona Cue square on the bar. 7.4:1 on black.", "$extensions": { "boona": { "dark": "{color.primitive.plum-300}" } } },
      "ink": { "$type": "color", "$value": "{color.primitive.plum-600}", "$description": "Boona Cue text on ground. 7.4:1 on white.", "$extensions": { "boona": { "dark": "{color.primitive.plum-200}" } } }
    },
    "automation": {
      "accent": { "$type": "color", "$value": "{color.primitive.teal-300}", "$description": "Client work square on the bar. 10.2:1 on black.", "$extensions": { "boona": { "dark": "{color.primitive.teal-300}" } } },
      "ink": { "$type": "color", "$value": "{color.primitive.teal-600}", "$description": "Client work text on ground. 5.5:1 on white.", "$extensions": { "boona": { "dark": "{color.primitive.teal-200}" } } }
    }
  },

  "font": {
    "family": {
      "sans": { "$type": "fontFamily", "$value": ["Host Grotesk", "system-ui", "-apple-system", "Segoe UI", "Roboto", "sans-serif"], "$description": "The one brand face. Host Grotesk, SIL Open Font Licence, free on Google Fonts. Self-host woff2 at /public/fonts; weights 400, 500, 600, 700." },
      "mono": { "$type": "fontFamily", "$value": ["ui-monospace", "Cascadia Mono", "SF Mono", "Menlo", "Consolas", "monospace"], "$description": "Code blocks only. System mono stack; not a brand face, so the two-typeface limit holds." }
    },
    "weight": {
      "regular": { "$type": "fontWeight", "$value": 400 },
      "medium": { "$type": "fontWeight", "$value": 500 },
      "semibold": { "$type": "fontWeight", "$value": 600 },
      "bold": { "$type": "fontWeight", "$value": 700 }
    },
    "size": {
      "$description": "Modular-ish scale, px. Body is 17 for a 60–70 character measure at 680px.",
      "13": { "$type": "dimension", "$value": "13px" },
      "14": { "$type": "dimension", "$value": "14px" },
      "15": { "$type": "dimension", "$value": "15px" },
      "17": { "$type": "dimension", "$value": "17px" },
      "19": { "$type": "dimension", "$value": "19px" },
      "21": { "$type": "dimension", "$value": "21px" },
      "24": { "$type": "dimension", "$value": "24px" },
      "30": { "$type": "dimension", "$value": "30px" },
      "40": { "$type": "dimension", "$value": "40px" },
      "52": { "$type": "dimension", "$value": "52px" },
      "64": { "$type": "dimension", "$value": "64px" }
    },
    "line-height": {
      "tight": { "$type": "number", "$value": 1.0 },
      "snug": { "$type": "number", "$value": 1.15 },
      "normal": { "$type": "number", "$value": 1.5 },
      "relaxed": { "$type": "number", "$value": 1.6 }
    },
    "letter-spacing": {
      "display": { "$type": "dimension", "$value": "-0.03em", "$description": "52px and up." },
      "heading": { "$type": "dimension", "$value": "-0.02em", "$description": "24px to 40px." },
      "body": { "$type": "dimension", "$value": "0em" }
    },
    "feature": {
      "numbers": { "$type": "string", "$value": "tabular-nums", "$description": "Applied to every readout, table and metric so digits line up." }
    }
  },

  "text": {
    "$description": "Composite text styles. Figma text styles and Tailwind components are generated from these.",
    "hero": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.64}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" }, "$description": "Home hero headline. Drops to 40px under 640px wide." },
    "display": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.52}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.display}" }, "$description": "Thumbnail and title-card numbers." },
    "h1": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.40}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.heading}" } },
    "h2": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.30}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.heading}" } },
    "h3": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.24}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.snug}", "letterSpacing": "{font.letter-spacing.heading}" } },
    "h4": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.21}", "fontWeight": "{font.weight.semibold}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.body}" } },
    "lead": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.19}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.body}" }, "$description": "Intro paragraphs under a headline." },
    "body": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.17}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.body}" } },
    "small": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.15}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.body}" }, "$description": "Captions, windows, form help." },
    "caption": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.13}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.normal}", "letterSpacing": "{font.letter-spacing.body}" }, "$description": "Smallest text allowed. Sentence case, never all caps." },
    "readout-number": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.30}", "fontWeight": "{font.weight.bold}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.heading}" }, "$description": "The number on a 64px bar. 24px on the 56px bar, 20px on the 48px bar." },
    "readout-label": { "$type": "typography", "$value": { "fontFamily": "{font.family.sans}", "fontSize": "{font.size.15}", "fontWeight": "{font.weight.medium}", "lineHeight": "{font.line-height.tight}", "letterSpacing": "{font.letter-spacing.body}" } },
    "code": { "$type": "typography", "$value": { "fontFamily": "{font.family.mono}", "fontSize": "{font.size.15}", "fontWeight": "{font.weight.regular}", "lineHeight": "{font.line-height.relaxed}", "letterSpacing": "{font.letter-spacing.body}" } }
  },

  "space": {
    "$description": "4px base. Use the scale, not arbitrary values.",
    "0": { "$type": "dimension", "$value": "0px" },
    "1": { "$type": "dimension", "$value": "4px" },
    "2": { "$type": "dimension", "$value": "8px" },
    "3": { "$type": "dimension", "$value": "12px" },
    "4": { "$type": "dimension", "$value": "16px" },
    "5": { "$type": "dimension", "$value": "20px" },
    "6": { "$type": "dimension", "$value": "24px" },
    "8": { "$type": "dimension", "$value": "32px" },
    "10": { "$type": "dimension", "$value": "40px" },
    "12": { "$type": "dimension", "$value": "48px" },
    "16": { "$type": "dimension", "$value": "64px" },
    "20": { "$type": "dimension", "$value": "80px" },
    "24": { "$type": "dimension", "$value": "96px" },
    "32": { "$type": "dimension", "$value": "128px" }
  },

  "size": {
    "$description": "Fixed sizes that encode UX rules.",
    "touch": { "$type": "dimension", "$value": "44px", "$description": "Minimum hit area for anything tappable (WCAG 2.5.8 / Apple HIG)." },
    "control-sm": { "$type": "dimension", "$value": "36px", "$description": "Compact buttons and inputs, desktop-only contexts." },
    "control-md": { "$type": "dimension", "$value": "44px", "$description": "Default button and input height." },
    "control-lg": { "$type": "dimension", "$value": "48px", "$description": "Primary CTA height." },
    "bar-sm": { "$type": "dimension", "$value": "48px", "$description": "Readout bar on video lower thirds and cards." },
    "bar-md": { "$type": "dimension", "$value": "56px", "$description": "Readout bar in product and case entries." },
    "bar-lg": { "$type": "dimension", "$value": "64px", "$description": "Readout bar under the hero." },
    "accent-square": { "$type": "dimension", "$value": "12px", "$description": "The product square on the bar. 10px on bar-sm." },
    "container": { "$type": "dimension", "$value": "1200px", "$description": "Max content width." },
    "measure": { "$type": "dimension", "$value": "68ch", "$description": "Max line length for body text." },
    "gutter": { "$type": "dimension", "$value": "24px", "$description": "Side gutter on phones; 56px from 1024px up." },
    "icon": { "$type": "dimension", "$value": "20px", "$description": "Inline icon size, 1.5px stroke." }
  },

  "radius": {
    "$description": "Decided 2026-11-03: the bar, buttons and chips are square; inputs get 2px; cards and images get 4px; only avatars are round.",
    "none": { "$type": "dimension", "$value": "0px" },
    "xs": { "$type": "dimension", "$value": "2px" },
    "sm": { "$type": "dimension", "$value": "4px" },
    "full": { "$type": "dimension", "$value": "9999px" }
  },

  "border": {
    "hairline": { "$type": "dimension", "$value": "1px" },
    "rule": { "$type": "dimension", "$value": "1.5px", "$description": "Outlined buttons, table rules." },
    "heavy": { "$type": "dimension", "$value": "2px", "$description": "Section rules, focus ring." },
    "focus-offset": { "$type": "dimension", "$value": "2px" }
  },

  "elevation": {
    "$description": "Flat by default. Depth comes from layering and the bar, not shadows. Only overlays get a shadow.",
    "0": { "$type": "shadow", "$value": "none", "$description": "Cards, bars, buttons." },
    "1": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "1px", "blur": "0px", "spread": "0px", "color": "{color.line}" }, "$description": "Sticky nav bottom edge." },
    "2": { "$type": "shadow", "$value": { "offsetX": "0px", "offsetY": "8px", "blur": "24px", "spread": "0px", "color": "#0000001F" }, "$description": "Menus, dialogs, toasts." }
  },

  "z": {
    "base": { "$type": "number", "$value": 0 },
    "raised": { "$type": "number", "$value": 10, "$description": "Cut-out figure in front of the bar." },
    "sticky": { "$type": "number", "$value": 100, "$description": "Nav." },
    "overlay": { "$type": "number", "$value": 1000, "$description": "Menus, dialogs." },
    "toast": { "$type": "number", "$value": 1100 }
  },

  "motion": {
    "$description": "Motion answers a user action; nothing moves on its own. All durations collapse to 0 under prefers-reduced-motion.",
    "duration": {
      "fast": { "$type": "duration", "$value": "120ms", "$description": "Hover, focus, toggles." },
      "base": { "$type": "duration", "$value": "200ms", "$description": "Menus, expand/collapse, theme switch." },
      "slow": { "$type": "duration", "$value": "320ms", "$description": "Dialogs, page-level reveals." }
    },
    "easing": {
      "standard": { "$type": "cubicBezier", "$value": [0.2, 0, 0, 1] },
      "enter": { "$type": "cubicBezier", "$value": [0, 0, 0.2, 1] },
      "exit": { "$type": "cubicBezier", "$value": [0.4, 0, 1, 1] }
    }
  },

  "breakpoint": {
    "sm": { "$type": "dimension", "$value": "640px" },
    "md": { "$type": "dimension", "$value": "768px" },
    "lg": { "$type": "dimension", "$value": "1024px" },
    "xl": { "$type": "dimension", "$value": "1280px" }
  }
}
